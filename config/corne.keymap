#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

&led_strip {
    chain-length = <27>;
};

/ {
    macros {
        // MACROS SIMPLIFICADAS - Sin wait/tap innecesarios
        
        spotlight: spotlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LGUI
                &macro_tap &kp SPACE
                &macro_release &kp LGUI
            >;
        };

        // ACENTOS - Solo estos necesitan delays para macOS
        accent_a: accent_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_wait_time 30  // Solo aquí necesitamos esperar
                &macro_tap &kp A
            >;
        };

        accent_e: accent_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_wait_time 30
                &macro_tap &kp E
            >;
        };

        accent_i: accent_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_wait_time 30
                &macro_tap &kp I
            >;
        };

        accent_o: accent_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_wait_time 30
                &macro_tap &kp O
            >;
        };

        accent_u: accent_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_wait_time 30
                &macro_tap &kp U
            >;
        };

        enye: enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp N
                &macro_release &kp LALT
                &macro_wait_time 30
                &macro_tap &kp N
            >;
        };

        // SÍMBOLOS SIMPLIFICADOS - Sin delays
        inv_question: inv_question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LSHIFT &kp LALT
                &macro_tap &kp FSLH
                &macro_release &kp LALT &kp LSHIFT
            >;
        };

        inv_exclaim: inv_exclaim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp N1
                &macro_release &kp LALT
            >;
        };
    };

    behaviors {
        // MOD-TAP PARA CAPAS (más estable que layer-tap)
        mt_space: mt_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        // HOLD-TAP PARA SHIFT (en pulgares)
        hm_shift: hm_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    // COMBOS para caracteres especiales (más eficiente que hold-tap)
    combos {
        compatible = "zmk,combos";
        
        combo_enye {
            timeout-ms = <30>;
            key-positions = <19 20>; // JK = ñ
            bindings = <&enye>;
        };
        
        combo_accent_mode {
            timeout-ms = <30>;
            key-positions = <37 40>; // Pulgares izq = modo acentos
            bindings = <&tog 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // CAPA 0: BASE - Sin hold-taps en vocales
        default_layer {
            display-name = "Base";
            bindings = 
                &kp ESC   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
                
                &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
                
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
                
                &kp LGUI  &mt_space 1 SPACE  &hm_shift LCTRL RET
                &hm_shift RCTRL RET  &mt_space 2 SPACE  &kp RGUI
            >;
        };

        // CAPA 1: SÍMBOLOS Y NÚMEROS
        symbols_layer {
            display-name = "Symbols";
            bindings = 
                &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
                
                &kp TILDE &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT
                &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp PIPE
                
                &trans    &kp MINUS &kp UNDER &kp LBKT  &kp RBKT  &kp LBRC
                &kp RBRC  &kp EQUAL &kp PLUS  &kp LT    &kp GT    &trans
                
                &trans    &trans    &trans
                &trans    &trans    &trans
            >;
        };

        // CAPA 2: NAVEGACIÓN Y MEDIA
        nav_layer {
            display-name = "Navigation";
            bindings = 
                &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &kp C_BRI_DN &kp C_BRI_UP &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE   &none
                
                &none        &kp HOME     &kp PG_DN    &kp PG_UP    &kp END      &none
                &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &none        &none
                
                &none        &kp C_PREV   &kp C_PP     &kp C_NEXT   &none        &none
                &none        &none        &none        &none        &none        &none
                
                &trans       &trans       &trans
                &trans       &trans       &trans
            >;
        };

        // CAPA 3: ESPAÑOL (activada por combo)
        spanish_layer {
            display-name = "Spanish";
            bindings = 
                &trans    &trans    &trans    &accent_e &trans    &trans
                &trans    &accent_u &accent_i &accent_o &trans    &trans
                
                &trans    &accent_a &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &enye     &inv_question
                
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &inv_exclaim &trans
                
                &trans    &mo 0     &trans
                &trans    &mo 0     &trans
            >;
        };
    };
};
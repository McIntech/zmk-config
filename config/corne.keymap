#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

/ {
        macros {

        vol_up: vol_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LCTRL
                &macro_tap &kp C_VOL_UP
                &macro_release &kp LCTRL
            >;
        };

        spotlight: spootlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
			    &macro_press &kp LGUI      // 1. Presiona ⌘ (Command)
			    &macro_tap   &kp SPACE     // 2. Toca SPACE mientras ⌘ sigue presionado
			    &macro_release &kp LGUI    // 3. Suelta ⌘ (Command)
            >;
        };

        macro_a_accent: macro_a_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp A
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_e_accent: macro_e_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp E
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_i_accent: macro_i_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp I
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_o_accent: macro_o_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp O
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_u_accent: macro_u_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp U
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        accent_dead: accent_dead {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
            >;
            wait-ms = <10>;
            tap-ms = <10>;
        };

        // tecla ñ
        ene_letter: ene_letter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LALT
                &macro_tap &kp N
                &macro_release &kp LALT
                &macro_tap &kp N
            >;
            wait-ms = <10>;
            tap-ms = <10>;
        };

        macro_enye: macro_enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp N
                &macro_release
                &kp LALT
                &macro_tap
                &kp N
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };
    };

    behaviors {
        a_accent: a_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_a_accent>;
        };

        e_accent: e_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_e_accent>;
        };

        i_accent: i_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_i_accent>;
        };

        o_accent: o_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_o_accent>;
        };

        u_accent: u_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_u_accent>;
        };

        enye: enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_enye>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
            // ----------  Fila 1  ----------
                &kp ESC
                &kp H
                &kp G
                &kp M
                &kp U
                &o_accent
            / ----------  Fila 1  ----------
                &i_accent
                &kp D
                &kp V
                &kp P
                &kp Q
                &spotlight
            // ----------  Fila 2  ----------
                &kp T
                &kp I
                &kp N
                &kp R
                &kp A
                &e_accent
            / ----------  Fila 1  ----------
                &a_accent
                &kp E
                &kp O
                &kp S
                &kp C
                &kp L
            // ----------  Fila 3  ----------
                &kp LSHFT
                &kp X
                &kp W
                &kp J
                &kp B
                &enye
            / ----------  Fila 1  ----------
                &u_accent
                &kp F
                &kp Y
                &kp K
                &kp Z
                &kp RIGHT_SHIFT
            // ----------  Fila 4  ----------
                &kp LGUI
                &mo 1
                &kp SPACE
            // ----------  Fila 5  ----------
                &kp BACKSPACE
                &mo 2
                &kp ENTER
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
            // ----------  Fila 1  ----------
                &vol_up
                &kp EXCL
                &kp AT
                &kp HASH
                &kp DLLR
                &kp PRCNT
            // ----------  Fila 2  ----------
                &kp CARET
                &kp AMPS
                &kp ASTRK
                &kp LPAR
                &kp RPAR
                &kp BSPC
            // ----------  Fila 3  ----------
                &kp LCTRL
                &trans
                &trans
                &trans
                &trans
                &trans
            // ----------  Fila 4  ----------
                &kp MINUS
                &kp EQUAL
                &kp LBKT
                &kp RBKT
                &kp BSLH
                &kp GRAVE
            // ----------  Fila 5  ----------
                &kp LSHFT
                &trans
                &trans
                &trans
                &trans
                &trans
            // ----------  Fila 6  ----------
                &kp UNDER
                &kp PLUS
                &kp LBRC
                &kp RBRC
                &kp PIPE
                &kp TILDE
            // ----------  Pulgares 1  ----------
                &kp LGUI
                &trans
                &kp SPACE
            // ----------  Pulgares 2  ----------
                &kp RET
                &trans
                &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
            // ----------  Fila 1  ----------
                &kp N0
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
            // ----------  Fila 1  ----------
                &kp N6
                &kp N7
                &kp N8
                &kp N9
                &kp N0
                &kp BSPC
            // ----------  Fila 1  ----------
                &bt BT_CLR
                &bt BT_SEL 0
                &bt BT_SEL 1
                &bt BT_SEL 2
                &bt BT_SEL 3
                &bt BT_SEL 4
            // ----------  Fila 1  ----------
                &kp LEFT
                &kp DOWN
                &kp UP
                &kp RIGHT
                &trans
                &trans
            // ----------  Fila 1  ----------
                &kp LSHFT
                &trans
                &trans
                &trans
                &trans
                &trans
            // ----------  Fila 1  ----------
                &trans
                &trans
                &trans
                &trans
                &trans
                &trans
            // ----------  Fila 1  ----------
                &kp LGUI
                &trans
                &kp SPACE
            / ----------  Fila 1  ----------
                &kp RET
                &trans
                &kp RALT
            >;
        };
    };
};

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Ajuste global del &mt por defecto */
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

/* Behaviors extra para probar variantes de Ctrl/A */
 / {
    behaviors {
        mt_hp: mt_hp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
        };

        mt_rel: mt_rel {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            hold-trigger-on-release;
        };

        mt_long: mt_long {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                /* FILA SUPERIOR: 6 pruebas izquierda, derecha normal */
                &mt      LCTRL A   &mt_hp    LCTRL A   &mt_rel   LCTRL A
                &mt_long LCTRL A   &mt       LCTRL A   &mt_hp    LCTRL A
                &kp Y &kp U &kp I &kp O &kp P &kp BSPC

                /* FILA HOME: 6 pruebas izquierda, derecha normal */
                &mt_rel  LCTRL A   &mt_long  LCTRL A   &mt       LCTRL A
                &mt_hp   LCTRL A   &mt_rel   LCTRL A   &mt_long  LCTRL A
                &kp H &kp J &kp K &kp L &kp SEMI &kp SQT

                /* FILA INFERIOR: izquierda passthrough, derecha normal */
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp G
                &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC

                /* PULGARES */
                           &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };
    };
};

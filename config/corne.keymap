#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Opcional: ajustar el &mt global si quieres */
&mt {
    tapping-term-ms = <200>;
    quick_tap_ms = <150>;
    flavor = "tap-preferred";
};

 / {
    behaviors {
        /* Variantes para probar distintos feels de Mod-Tap */
        mt_tap: mt_tap {
            compatible = "zmk,behavior-mod-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick_tap_ms = <150>;
        };

        mt_hold: mt_hold {
            compatible = "zmk,behavior-mod-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
        };

        mt_rel: mt_rel {
            compatible = "zmk,behavior-mod-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick_tap_ms = <120>;
            hold-trigger-on-release;
        };

        mt_long: mt_long {
            compatible = "zmk,behavior-mod-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick_tap_ms = <200>;
        };

        mt_quick0: mt_quick0 {
            compatible = "zmk,behavior-mod-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
        };

        mt_short: mt_short {
            compatible = "zmk,behavior-mod-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick_tap_ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "TEST_A_CTRL";
            bindings = <
                /* FILA SUPERIOR: 6 teclas IZQ = pruebas A/CTRL, 6 DER = transparentes */
                &mt        LCTRL A   &mt_tap   LCTRL A   &mt_hold  LCTRL A
                &mt_rel    LCTRL A   &mt_long  LCTRL A   &mt_quick0 LCTRL A
                &trans &trans &trans &trans &trans &trans

                /* FILA HOME: 6 IZQ = otras variantes, 6 DER = transparentes */
                &mt_short  LCTRL A   &mt       LCTRL A   &mt_tap   LCTRL A
                &mt_hold   LCTRL A   &mt_rel   LCTRL A   &mt_long  LCTRL A
                &trans &trans &trans &trans &trans &trans

                /* FILA INFERIOR: 6 IZQ = repite/mezcla, 6 DER = transparentes */
                &mt_quick0 LCTRL A   &mt_short LCTRL A   &mt       LCTRL A
                &mt_tap    LCTRL A   &mt_hold  LCTRL A   &mt_rel   LCTRL A
                &trans &trans &trans &trans &trans &trans

                /* PULGARES: 3 IZQ = más pruebas, 3 DER = transparentes */
                         &mt       LCTRL A   &mt_tap  LCTRL A   &mt_hold LCTRL A
                         &trans    &trans    &trans
            >;
        };
    };
};

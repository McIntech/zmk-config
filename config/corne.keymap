#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

/ {
        macros {

        vol_up: vol_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_VOL_UP
            >;
        };

        spootlight: spootlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
			    &macro_press &kp LGUI      // 1. Presiona ⌘ (Command)
			    &macro_tap   &kp SPACE     // 2. Toca SPACE mientras ⌘ sigue presionado
			    &macro_release &kp LGUI    // 3. Suelta ⌘ (Command)
            >;
        };

        macro_a_accent: macro_a_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp A
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_e_accent: macro_e_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp E
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_i_accent: macro_i_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp I
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_o_accent: macro_o_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp O
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        macro_u_accent: macro_u_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press
                &kp LALT
                &macro_tap
                &kp E
                &macro_release
                &kp LALT
                &macro_tap
                &kp U
            >;
            wait-ms = <1>;
            tap-ms = <1>;
        };

        accent_dead: accent_dead {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
            >;
            wait-ms = <10>;
            tap-ms = <10>;
        };

        // tecla ñ
        enye: enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LALT
                &macro_tap &kp N
                &macro_release &kp LALT
                &macro_tap &kp N
            >;
            wait-ms = <10>;
            tap-ms = <10>;
        };

    };

    behaviors {
        a_accent: a_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_a_accent>;
        };

        e_accent: e_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_e_accent>;
        };

        i_accent: i_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_i_accent>;
        };

        o_accent: o_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_o_accent>;
        };

        u_accent: u_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_u_accent>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
            // ----------  Mano izquierda - Fila 1  ----------
                &kp ESC
                &kp B
                &kp G
                &kp M
                &kp U
                &kp H
            // ----------  Mano derecha - Fila 1  ----------
                &kp Q
                &kp D
                &kp V
                &kp P
                &kp F
                &kp BACKSPACE
            // ----------  Mano izquierda - Fila 2  ----------
                &kp TAB
                &kp T
                &kp N
                &kp R
                &kp A
                &kp I
            // ----------  Mano derecha - Fila 2  ----------
                &kp C
                &kp E
                &kp O
                &kp S
                &kp L
                &enye // ñ
            // ----------  Mano izquierda - Fila 3  ----------
                &kp LSHFT
                &kp SINGLE_QUOTE
                &kp X
                &kp W
                &kp J
                &kp COMMA
            // ----------  Mano derecha - Fila 3  ----------
                &kp DOT
                &kp Y
                &kp K
                &kp Z
                &kp SEMICOLON
                &kp RSHFT
            // ----------  Pulgares 1  ----------
                &kp LGUI
                &mo 1
                &kp SPACE
            // ----------  Pulgares 2  ----------
                &kp ENTER
                &mo 2
                &spootlight
            >;
        };

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
            // ----------  Fila 1  ----------
                &kp EXCL
                &kp SQT
                &kp HASH
                &kp DLLR
                &kp PERCENT
                &kp LPAR
                &kp RPAR
                &kp AMPS
                &kp FSLH
                &kp EQUAL
                &kp QMARK
                &kp PIPE

            // ----------  Fila 2  ----------
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
                &kp LBRC
                &kp RBRC
                &kp N6
                &kp N7
                &kp N8
                &kp N9
                &kp N0

            // ----------  Fila 3  ----------
                &kp AT
                &kp GRAVE
                &kp BSLH
                &kp TILDE
                &kp CARET
                &kp LBRC
                &kp RBRC
                &kp PLUS
                &kp MINUS
                &kp STAR
                &kp UNDERSCORE
                &kp COLON
            // ----------  Pulgares 1  ----------
                &kp LGUI
                &mo 1
                &kp SPACE
            // ----------  Pulgares 2  ----------
                &kp ENTER
                &mo 2
                &spootlight
            >;
        };

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
            // ----------  Fila 1  ----------
                &kp LC(C_BRIGHTNESS_INC)
                &kp LC(C_VOLUME_DOWN)
                &kp LC(C_PLAY_PAUSE)
                &kp LC(C_BRIGHTNESS_INC)
                &kp LC(C_BRIGHTNESS_DEC)
                &kp LC(C_NEXT)
                &kp LC(C_PREV)
                &kp LC(C_AC_SEARCH)
                &kp LC(C_AC_DESKTOP_SHOW_ALL_WINDOWS)
                &kp LC(C_AC_DESKTOP_SHOW_ALL_APPLICATIONS)
                &kp LC(C_AC_NEXT_KEYBOARD_LAYOUT_SELECT)
                &kp LC(K_CUT)
            // ----------  Fila 2  ----------
                &kp LC(K_COPY)
                &kp LC(K_PASTE)
                &kp N2
                &kp N3
                &kp N4
                &kp N5
                &kp LEFT_ARROW
                &kp DOWN_ARROW
                &kp UP_ARROW
                &kp RIGHT_ARROW
                &kp N1
                &kp N3
            // ----------  Fila 3  ----------
                &vol_up
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
                &vol_up
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
            // ----------  Fila 1  ----------
                &kp LGUI
                &trans
                &kp SPACE
            // ----------  Fila 1  ----------
                &kp RET
                &trans
                &kp RALT
            >;
        };
    };
};

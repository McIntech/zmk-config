#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        spootlight: spootlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "SPOOTLIGHT";
        };
    };

    behaviors {
        enye: enye {
            compatible = "zmk,behavior-send-string";
            label = "ENYE";
            #binding-cells = <0>;
            text = "ñ";
            wait-ms = <30>;
            tap-ms = <40>;
        };

        a_accent: a_accent {
            compatible = "zmk,behavior-send-string";
            label = "A_ACCENT";
            #binding-cells = <0>;
            text = "á";
            wait-ms = <30>;
            tap-ms = <40>;
        };

        e_accent: e_accent {
            compatible = "zmk,behavior-send-string";
            label = "E_ACCENT";
            #binding-cells = <0>;
            text = "é";
            wait-ms = <30>;
            tap-ms = <40>;
        };

        i_accent: i_accent {
            compatible = "zmk,behavior-send-string";
            label = "I_ACCENT";
            #binding-cells = <0>;
            text = "í";
            wait-ms = <30>;
            tap-ms = <40>;
        };

        o_accent: o_accent {
            compatible = "zmk,behavior-send-string";
            label = "O_ACCENT";
            #binding-cells = <0>;
            text = "ó";
            wait-ms = <30>;
            tap-ms = <40>;
        };

        u_accent: u_accent {
            compatible = "zmk,behavior-send-string";
            label = "U_ACCENT";
            #binding-cells = <0>;
            text = "ú";
            wait-ms = <30>;
            tap-ms = <40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp H  &kp G  &kp M     &kp U  &o_accent    &i_accent      &kp D  &kp V        &kp P  &kp Q  &kp ENTER
&kp T      &kp I  &kp N  &kp R     &kp A  &e_accent    &a_accent      &kp E  &kp O        &kp S  &kp C  &kp L
&kp LSHFT  &kp X  &kp W  &kp J     &kp B  &enye        &u_accent      &kp F  &kp Y        &kp K  &kp Z  &kp LEFT_SHIFT
                         &kp LGUI  &mo 1  &kp SPACE    &kp BACKSPACE  &mo 2  &spootlight
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp N0      &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };
    };
};

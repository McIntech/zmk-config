#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

/ {
    macros {
        // SPOTLIGHT - Sin delays
        spotlight: spotlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LGUI
                &macro_tap &kp SPACE
                &macro_release &kp LGUI
            >;
        };

        // ACENTOS - Con delays mínimos solo donde macOS lo requiere
        accent_a: accent_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_tap &kp A
            >;
        };

        accent_e: accent_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_tap &kp E
            >;
        };

        accent_i: accent_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_tap &kp I
            >;
        };

        accent_o: accent_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_tap &kp O
            >;
        };

        accent_u: accent_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
                &macro_tap &kp U
            >;
        };

        enye: enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <10>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp N
                &macro_release &kp LALT
                &macro_tap &kp N
            >;
        };

        // SIGNOS INVERTIDOS - Sin delays
        inv_question: inv_question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LSHIFT &kp LALT
                &macro_tap &kp FSLH
                &macro_release &kp LALT &kp LSHIFT
            >;
        };

        inv_exclaim: inv_exclaim {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                &macro_press &kp LALT
                &macro_tap &kp N1
                &macro_release &kp LALT
            >;
        };

        // MEDIA CONTROLS - Sin delays  
        vol_down: vol_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_VOL_DN>;
        };

        vol_up: vol_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_VOL_UP>;
        };

        play_pause: play_pause {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_PP>;
        };

        prev_track: prev_track {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_PREV>;
        };

        next_track: next_track {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_NEXT>;
        };

        bright_down: bright_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_BRI_DN>;
        };

        bright_up: bright_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C_BRI_UP>;
        };
    };

    behaviors {
        // HOME ROW MODS - Optimizado para no interferir con escritura
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        // LAYER TAP - Para cambiar capas desde pulgares
        lt: lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        // COMBO: JK = Ñ
        combo_enye {
            timeout-ms = <35>;
            key-positions = <19 20>;
            bindings = <&enye>;
            layers = <0>;
        };

        // COMBO: DF = Á
        combo_a {
            timeout-ms = <35>;
            key-positions = <15 16>;
            bindings = <&accent_a>;
            layers = <0>;
        };

        // COMBO: WE = É
        combo_e {
            timeout-ms = <35>;
            key-positions = <2 3>;
            bindings = <&accent_e>;
            layers = <0>;
        };

        // COMBO: UI = Í
        combo_i {
            timeout-ms = <35>;
            key-positions = <7 8>;
            bindings = <&accent_i>;
            layers = <0>;
        };

        // COMBO: IO = Ó
        combo_o {
            timeout-ms = <35>;
            key-positions = <8 9>;
            bindings = <&accent_o>;
            layers = <0>;
        };

        // COMBO: YU = Ú
        combo_u {
            timeout-ms = <35>;
            key-positions = <6 7>;
            bindings = <&accent_u>;
            layers = <0>;
        };

        // COMBO: ./ = ¿
        combo_inv_q {
            timeout-ms = <35>;
            key-positions = <33 34>;
            bindings = <&inv_question>;
            layers = <0>;
        };

        // COMBO: ZX = ¡
        combo_inv_e {
            timeout-ms = <35>;
            key-positions = <25 26>;
            bindings = <&inv_exclaim>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // CAPA 0: BASE - Limpia, sin hold-taps en teclas frecuentes
        default_layer {
            display-name = "Base";
            bindings = 
            // Fila 1
                &kp ESC   &kp Q     &kp W     &kp E     &kp R     &kp T
                &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
            // Fila 2
                &kp TAB   &kp A     &kp S     &kp D     &kp F     &kp G
                &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
            // Fila 3
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B
                &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
            // Pulgares
                &kp LCTRL &lt 1 SPACE &kp LGUI
                &kp RALT  &lt 2 ENTER &spotlight
            >;
        };

        // CAPA 1: SÍMBOLOS Y NÚMEROS
        symbols_layer {
            display-name = "Symbols";
            bindings = 
            // Fila 1
                &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5
                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
            // Fila 2
                &kp TILDE &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT
                &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp PIPE
            // Fila 3
                &trans    &kp MINUS &kp UNDER &kp LBKT  &kp RBKT  &kp LBRC
                &kp RBRC  &kp EQUAL &kp PLUS  &kp LT    &kp GT    &kp BSLH
            // Pulgares
                &trans    &trans    &trans
                &trans    &mo 3     &trans
            >;
        };

        // CAPA 2: NAVEGACIÓN Y FUNCIÓN
        nav_layer {
            display-name = "Nav";
            bindings = 
            // Fila 1
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6
                &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
            // Fila 2
                &kp CAPS  &kp HOME  &kp PG_DN &kp PG_UP &kp END   &none
                &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp INS   &kp DEL
            // Fila 3
                &trans    &none     &none     &none     &none     &none
                &none     &none     &none     &none     &none     &trans
            // Pulgares
                &trans    &mo 3     &trans
                &trans    &trans    &trans
            >;
        };

        // CAPA 3: CONTROL Y MEDIA
        control_layer {
            display-name = "Control";
            bindings = 
            // Fila 1
                &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                &none        &none        &none        &none        &none        &bootloader
            // Fila 2
                &none        &bright_down &bright_up   &none        &none        &none
                &prev_track  &vol_down    &vol_up      &next_track  &play_pause  &kp C_MUTE
            // Fila 3
                &none        &none        &none        &none        &none        &none
                &none        &none        &none        &none        &none        &none
            // Pulgares
                &trans       &trans       &trans
                &trans       &trans       &trans
            >;
        };
    };
};

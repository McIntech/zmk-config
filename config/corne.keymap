#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWERTY";
            bindings = <
                /* FILA SUPERIOR: Probando A con CTRL */
                &mt LCTRL A   &kp W   &kp E   &kp R   &kp T   &kp Y        &kp U   &kp I   &kp O   &kp P   &kp LBKT &kp RBKT

                /* FILA HOME: S con CTRL, resto normal */
                &mt LCTRL S   &kp D   &kp F   &kp G   &kp H   &kp J        &kp K   &kp L   &kp SEMI &kp SQT &kp RET

                /* FILA INFERIOR: Z con SHIFT */
                &mt LSHFT Z   &kp X   &kp C   &kp V   &kp B   &kp N        &kp M   &kp COMMA &kp DOT &kp FSLH &kp BSPC

                /* PULGARES (6 teclas totales: 3 izquierda, 3 derecha) */
                &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp RALT
            >;
        };

        layer_1 {
            label = "NÚMEROS";
            bindings = <
                &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6        &kp N7   &kp N8   &kp N9   &kp N0   &trans   &trans
                &trans   &trans   &trans   &trans   &trans   &trans        &trans   &trans   &trans   &trans   &trans   &trans
                &trans   &trans   &trans   &trans   &trans   &trans        &trans   &trans   &trans   &trans   &trans   &trans

                &trans   &trans   &trans        &trans   &trans   &trans
            >;
        };

        layer_2 {
            label = "SÍMBOLOS";
            bindings = <
                &kp EXCL   &kp AT   &kp HASH   &kp DLLR   &kp PRCNT   &kp CARET        &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &trans   &trans
                &trans     &trans   &trans     &trans     &trans     &trans        &trans     &trans     &trans     &trans     &trans   &trans
                &trans     &trans   &trans     &trans     &trans     &trans        &trans     &trans     &trans     &trans     &trans   &trans

                &trans     &trans   &trans        &trans     &trans   &trans
            >;
        };
    };
};

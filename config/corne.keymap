/*
 * Author: Franco Limón
 * Teclado Corne con keymap en español (macOS)
 * Teclado dividido 6x3 + 3 (thumbs) por lado
 * Nice!Nano v2 como controlador
 * Firmware basado en ZMK
*/

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

/ {
        macros {

        vol_up: vol_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_VOL_UP
            >;
        };

        spootlight: spootlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
			    &macro_press &kp LGUI      // 1. Presiona ⌘ (Command)
			    &macro_tap   &kp SPACE     // 2. Toca SPACE mientras ⌘ sigue presionado
			    &macro_release &kp LGUI    // 3. Suelta ⌘ (Command)
            >;
        };

        accent_dead: accent_dead {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LALT
                &macro_tap &kp E
                &macro_release &kp LALT
            >;
            wait-ms = <20>;
            tap-ms = <20>;
        };

        // Símbolos con Shift para macOS - Fila 1
        exclamation: exclamation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N1
                &macro_release &kp LSHIFT
            >;
        };

        hash_sym: hash_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N3
                &macro_release &kp LSHIFT
            >;
        };

        dollar: dollar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N4
                &macro_release &kp LSHIFT
            >;
        };

        percent_sym: percent_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N5
                &macro_release &kp LSHIFT
            >;
        };

        ampersand: ampersand {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N7
                &macro_release &kp LSHIFT
            >;
        };

        left_paren: left_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N9
                &macro_release &kp LSHIFT
            >;
        };

        right_paren: right_paren {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N0
                &macro_release &kp LSHIFT
            >;
        };

        question: question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp FSLH
                &macro_release &kp LSHIFT
            >;
        };

        pipe_sym: pipe_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp BSLH
                &macro_release &kp LSHIFT
            >;
        };

        // Símbolos con Shift para macOS - Fila 3
        at_sym: at_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N2
                &macro_release &kp LSHIFT
            >;
        };

        tilde_sym: tilde_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp GRAVE
                &macro_release &kp LSHIFT
            >;
        };

        caret_sym: caret_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N6
                &macro_release &kp LSHIFT
            >;
        };

        plus_sym: plus_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp EQUAL
                &macro_release &kp LSHIFT
            >;
        };

        star_sym: star_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N8
                &macro_release &kp LSHIFT
            >;
        };

        underscore: underscore {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp MINUS
                &macro_release &kp LSHIFT
            >;
        };

        colon_sym: colon_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp SEMICOLON
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para < (menor que)
        less_than: less_than {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp COMMA
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para > (mayor que)
        greater_than: greater_than {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp DOT
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para = (igual)
        equal_sym: equal_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>;
        };

        // Macro para [ (corchete izquierdo)
        left_bracket: left_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT>;
        };

        // Macro para ] (corchete derecho)
        right_bracket: right_bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RBKT>;
        };

        // Macro para { (llave izquierda)
        left_brace: left_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp LBKT
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para } (llave derecha)
        right_brace: right_brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp RBKT
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para * (multiplicación)
        multiply_sym: multiply_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&star_sym>;
        };

        // Macro para ` (acento grave)
        grave_sym: grave_sym {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE>;
        };

        // Macros para TAP (letra normal)
        macro_tap_a: macro_tap_a {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A>;
        };

        macro_tap_e: macro_tap_e {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp E>;
        };

        macro_tap_i: macro_tap_i {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp I>;
        };

        macro_tap_o: macro_tap_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O>;
        };

        macro_tap_u: macro_tap_u {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp U>;
        };

        // Macros para HOLD (letra con acento)
        macro_a_accent: macro_a_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <10>;
            bindings = <
                &kp LA(E)
                &kp A
            >;
        };

        macro_e_accent: macro_e_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <10>;
            bindings = <
                &kp LA(E)
                &kp E
            >;
        };

        macro_i_accent: macro_i_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <10>;
            bindings = <
                &kp LA(E)
                &kp I
            >;
        };

        macro_o_accent: macro_o_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <10>;
            bindings = <
                &kp LA(E)
                &kp O
            >;
        };

        macro_u_accent: macro_u_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms  = <10>;
            bindings = <
                &kp LA(E)
                &kp U
            >;
        };

        // Macro para TAP (letra n normal)
        macro_tap_n: macro_tap_n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N>;
        };

        // Macro para HOLD (letra ñ)
        enye: enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <10>;
            bindings = <
                &kp LA(N)
                &kp N
            >;
        };

        // Macro para TAP (dos puntos :)
        macro_tap_colon: macro_tap_colon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp SEMICOLON
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para HOLD (punto y coma ;)
        macro_semicolon: macro_semicolon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>;
        };

        // Macro para TAP (signo de interrogación de apertura ¿)
        macro_tap_inverted_question: macro_tap_inverted_question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_press &kp LALT
                &macro_tap &kp FSLH
                &macro_release &kp LALT
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para HOLD (signo de interrogación ?)
        macro_question: macro_question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp FSLH
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para TAP (comilla simple ')
        macro_tap_single_quote: macro_tap_single_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SINGLE_QUOTE>;
        };

        // Macro para HOLD (comilla doble ")
        macro_double_quote: macro_double_quote {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp SINGLE_QUOTE
                &macro_release &kp LSHIFT
            >;
        };

        // Macro para TAP (coma ,)
        macro_tap_comma: macro_tap_comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COMMA>;
        };

        // Macro para HOLD (punto .)
        macro_dot: macro_dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT>;
        };

        // Macro para TAP (guion -)
        macro_tap_minus: macro_tap_minus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS>;
        };

        // Macro para HOLD (guion bajo _)
        macro_underscore: macro_underscore {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp MINUS
                &macro_release &kp LSHIFT
            >;
        };

        mc0: mc0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LCTRL
                &macro_tap &kp C
                &macro_release &kp LCTRL
            >;
        };

        // ¡ / ! (exclamación invertida / exclamación)
        exclamation_marks: exclamation_marks {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&macro_exclamation>, <&macro_tap_inverted_exclamation>;
        };

        macro_tap_inverted_exclamation: macro_tap_inverted_exclamation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LALT
                &macro_tap &kp N1
                &macro_release &kp LALT
            >;
        };

        macro_exclamation: macro_exclamation {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHIFT
                &macro_tap &kp N1
                &macro_release &kp LSHIFT
            >;
        };

        // / \ (slash / backslash)
        slash_backslash: slash_backslash {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&macro_backslash>, <&macro_tap_slash>;
        };

        macro_tap_slash: macro_tap_slash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp FSLH>;
        };

        macro_backslash: macro_backslash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BSLH>;
        };

        // MC1 - Bajar brillo
        mc1: mc1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_BRIGHTNESS_DEC
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC2 - Subir brillo
        mc2: mc2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_BRIGHTNESS_INC
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC3 - Exposé (mostrar todas las apps)
        mc3: mc3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LCTRL
                &macro_tap &kp UP
                &macro_release &kp LCTRL
            >;
        };

        // MC4 - Spotlight (ya lo tienes como 'spootlight')
        mc4: mc4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LGUI
                &macro_tap &kp SPACE
                &macro_release &kp LGUI
            >;
        };

        // MC5 - Micrófono mute/unmute
        mc5: mc5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_MUTE
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC6 - No molestar (Focus)
        mc6: mc6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LGUI
                &macro_press &kp LSHIFT
                &macro_tap &kp D
                &macro_release &kp LSHIFT
                &macro_release &kp LGUI
            >;
        };

        // MC7 - Canción anterior
        mc7: mc7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_PREV
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC8 - Play/Pause
        mc8: mc8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_PLAY_PAUSE
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC9 - Canción siguiente
        mc9: mc9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_NEXT
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC10 - Silenciar volumen
        mc10: mc10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_MUTE
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC11 - Bajar volumen
        mc11: mc11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_VOL_DN
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

        // MC12 - Subir volumen
        mc12: mc12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &macro_tap &kp C_VOL_UP
            >;
            wait-ms = <20>;
            tap-ms = <25>;
        };

    };

    behaviors {
        a_accent: a_accent {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_a_accent>, <&macro_tap_a>;
        };

        e_accent: e_accent {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_e_accent>, <&macro_tap_e>;
        };

        i_accent: i_accent {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_i_accent>, <&macro_tap_i>;
        };

        o_accent: o_accent {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_o_accent>, <&macro_tap_o>;
        };

        u_accent: u_accent {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_u_accent>, <&macro_tap_u>;
        };

        n_enye: n_enye {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&enye>, <&macro_tap_n>;
        };

        colon_semicolon: colon_semicolon {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_semicolon>, <&macro_tap_colon>;
        };

        question_marks: question_marks {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_question>, <&macro_tap_inverted_question>;
        };

        quote_marks: quote_marks {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_double_quote>, <&macro_tap_single_quote>;
        };

        comma_dot: comma_dot {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_dot>, <&macro_tap_comma>;
        };

        minus_underscore: minus_underscore {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <0>;
            bindings = <&macro_underscore>, <&macro_tap_minus>;
        };
        
    };

    keymap {
        compatible = "zmk,keymap";

        // Para esta parte quiero que sea una tecla para poner acentos ´ como lo hago en el teclado en español si pongo ´ + a = á , quiero que se sienta fluido.
        // Igual para la ñ crea una tecla super fluida unicamente para la ñ

        // |  ESC   |  Q  |  W  |  E  |  R  |  T  |     |  Y  |  U  |   I   |   O   |   P   | BACKSPACE |
        // |  TAB   |  A  |  S  |  D  |  F  |  G  |     |  H  |  J  |   K   |   L   |   Ñ   |   : / ;   |
        // | LSHIFT |  Z  |  X  |  C  |  V  |  B  |     |  N  |  M  | , / . | - / _ | ' / " |  LSHIFT   |

        //    | ⌘ LGUI | MO(1) | SPACE |     | ENTER | MO(2) | CTRL |

        default_layer {
            display-name = "Default Layer";
            bindings = <
            // Left hand - Row 1
                &kp ESC
                &kp Q
                &kp W
                &kp E
                &kp R
                &kp T
            // Right hand - Row 1
                &kp Y
                &kp U
                &kp I
                &kp O
                &kp P
                &kp BACKSPACE
            // Left hand - Row 2
                &kp TAB
                &kp A
                &kp S
                &kp D
                &kp F
                &kp G
            // Right hand - Row 2
                &kp H
                &kp J
                &kp K
                &kp L
		        &n_enye 0 0
		        &colon_semicolon 0 0
            // Left hand - Row 3
                &kp LSHIFT
                &kp Z
                &kp X
		        &kp C
                &kp V
                &kp B
            // Right hand - Row 3
                &kp N
                &kp M
                &comma_dot 0 0
                &minus_underscore 0 0
                &quote_marks 0 0
                &kp LSHIFT
            // Thumbs - Left
                &kp LGUI
                &mo 1
                &kp SPACE
            // Thumbs - Right
                &kp ENTER
                &mo 2
                &kp LCTRL
            >;
        };

        // MC0 = CTRL + C
        // MC1 = CTRL + SHIFT + P

        // | MC0 | ¡ / ! |  @  |  #  |  $  |  %  |     |  ^  |  &  |  *  |  (  |  )  |  /  |
        // | TAB |   1   |  2  |  3  |  4  |  5  |     |  +  | -/_ |  |  |  {  |  }  |  \  |
        // | MC1 |   6   |  7  |  8  |  9  |  0  |     |  <  |  >  |  `  |  [  |  ]  |  ~  |

        // | ⌘ LGUI | MO(1) | SPACE |     | ENTER | MO(2) | SPOOTLIGHT |

        raise_layer {
            display-name = "Raise Layer";
            bindings = <
            // Left hand - Row 1
                &mc0
                &exclamation_marks 0 0
                &at_sym
                &hash_sym
                &dollar
                &percent_sym
            // Right hand - Row 1
                &caret_sym
                &ampersand
                &star_sym
                &left_paren
                &right_paren
                &kp FSLH
            // Left hand - Row 2
                &kp TAB
                &kp N1
                &kp N2
                &kp N3
                &kp N4
                &kp N5
            // Right hand - Row 2
                &plus_sym
                &minus_underscore 0 0
                &pipe_sym
                &left_brace
                &right_brace
                &kp BSLH
            // Left hand - Row 3
                &mc1
                &kp N6
                &kp N7
                &kp N8
                &kp N9
                &kp N0
            // Right hand - Row 3
                &less_than
                &greater_than
                &grave_sym
                &left_bracket
                &right_bracket
                &tilde_sym
            // Thumbs - Left
                &kp LGUI
                &mo 1
                &kp SPACE
            // Thumbs - Right
                &kp ENTER
                &mo 2
                &spootlight
            >;
        };

        // MC1 = Bajar brillo
        // MC2 = Subir brillo
        // MC3 = ctrl + down
        // MC10 = previous track
        // MC11 = play/pause
        // MC12 = next track

        // |     |     |     |  É  |     |     |     |  Ú  |  Í  |  Ó  |      |      |      |
        // |     |  Á  |     |     |     |     |     | ⬅️  | ⬇️  | ➡️  |  ➡️  |      |      |
        // | BTC | BT1 | BT2 | BT3 | BT4 | BT5 |     | MC1 | MC2 | MC3 | MC10 | MC11 | MC12 |

        //    | ⌘ LGUI | MO(1) | SPACE |     | ENTER | MO(2) | SPOOTLIGHT |

        lower_layer {
            display-name = "Lower Layer";
            bindings = <
            // Left hand - Row 1
                &none
                &none
                &none
                &macro_e_accent
                &none
                &none
            // Right hand - Row 1
                &macro_u_accent
                &macro_i_accent
                &macro_o_accent
                &none
                &none
                &none
            // Left hand - Row 2
                &none
                &macro_a_accent
                &none
                &none
                &none
                &none
            // Right hand - Row 2
                &kp LEFT
                &kp DOWN
                &kp UP
                &kp RIGHT
                &none
                &none
            // Left hand - Row 3
                &bt BT_CLR
                &bt BT_SEL 0
                &bt BT_SEL 1
                &bt BT_SEL 2
                &bt BT_SEL 3
                &bt BT_SEL 4
            // Right hand - Row 3
                &mc1
                &mc2
                &mc3
                &mc7
                &mc8
                &mc9
            // Thumbs - Left
                &kp LGUI
                &mo 1
                &kp SPACE
            // Thumbs - Right
                &kp ENTER
                &mo 2
                &spootlight
            >;
        };
    };
};
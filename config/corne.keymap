#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "corne.dtsi"

/ {
    macros {
        spotlight: spootlight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
        };

        macro_a_accent: macro_a_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp E>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp A>;
            wait-ms = <50>;
            tap-ms = <50>;
        };

        macro_e_accent: macro_e_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp E>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp E>;
            wait-ms = <50>;
            tap-ms = <50>;
        };

        macro_i_accent: macro_i_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp E>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp I>;
            wait-ms = <50>;
            tap-ms = <50>;
        };

        macro_o_accent: macro_o_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp E>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp O>;
            wait-ms = <50>;
            tap-ms = <50>;
        };

        macro_u_accent: macro_u_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp E>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp U>;
            wait-ms = <50>;
            tap-ms = <50>;
        };

        macro_enye: macro_enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LALT>
                     , <&macro_tap &kp N>
                     , <&macro_release &kp LALT>
                     , <&macro_tap &kp N>;
            wait-ms = <50>;
            tap-ms = <50>;
        };
    };

    behaviors {
        a_accent: a_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_a_accent>;
        };

        e_accent: e_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_e_accent>;
        };

        i_accent: i_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_i_accent>;
        };

        o_accent: o_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_o_accent>;
        };

        u_accent: u_accent {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_u_accent>;
        };

        enye: enye {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_enye>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB    &kp H  &kp G  &kp M     &kp U  &o_accent  &i_accent  &kp D  &kp V       &kp P  &kp Q  &kp ENTER
&kp T      &kp I  &kp N  &kp R     &kp A  &e_accent  &a_accent  &kp E  &kp O       &kp S  &kp C  &kp L
&kp LSHFT  &kp X  &kp W  &kp J     &kp B  &enye      &u_accent  &kp F  &kp Y       &kp K  &kp Z  &kp LEFT_SHIFT
                         &kp LGUI  &mo 1  &kp SPACE  &kp BACKSPACE  &mo 2  &spotlight
            >;
        };

        raise_layer {
            display-name = "Raise Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        lower_layer {
            display-name = "Lower Layer";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp N0      &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };
    };
};

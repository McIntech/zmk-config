#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "TEST_A_CTRL";
            bindings = <
                /* FILA SUPERIOR: 6 teclas IZQ = pruebas A/CTRL, 6 DER = transparentes */
                &mt        LCTRL A   &mt       LCTRL A   &mt       LCTRL A
                &mt        LCTRL A   &mt       LCTRL A   &mt       LCTRL A
                &trans &trans &trans &trans &trans &trans

                /* FILA HOME: 6 IZQ = otras variantes, 6 DER = transparentes */
                &mt        LCTRL A   &mt       LCTRL A   &mt       LCTRL A
                &mt        LCTRL A   &mt       LCTRL A   &mt       LCTRL A
                &trans &trans &trans &trans &trans &trans

                /* FILA INFERIOR: 6 IZQ = repite/mezcla, 6 DER = transparentes */
                &mt        LCTRL A   &mt       LCTRL A   &mt       LCTRL A
                &mt        LCTRL A   &mt       LCTRL A   &mt       LCTRL A
                &trans &trans &trans &trans &trans &trans

                /* PULGARES: 3 IZQ = más pruebas, 3 DER = transparentes */
                         &mt       LCTRL A   &mt       LCTRL A   &mt       LCTRL A
                         &trans    &trans    &trans
            >;
        };
    };
};
